{
  "version": "31.3.2",
  "pages": [
    {
      "id": "v0qubGjVoCkS9j5dkIKj",
      "name": "Context",
      "cells": [
        {
          "id": "ctx-1",
          "type": "layer"
        },
        {
          "id": "ctx-title",
          "type": "node",
          "parent": "ctx-1",
          "label": "Video Streaming Platform — System Context (C4 Level 1)"
        },
        {
          "id": "ctx-viewer",
          "type": "node",
          "parent": "ctx-1",
          "label": "Viewer\n[Person]\n\nWatches videos, likes,\ncomments, subscribes"
        },
        {
          "id": "ctx-creator",
          "type": "node",
          "parent": "ctx-1",
          "label": "Creator / Streamer\n[Person]\n\nUploads videos, live streams,\nmanages monetization"
        },
        {
          "id": "ctx-admin",
          "type": "node",
          "parent": "ctx-1",
          "label": "Admin / Manager\n[Person]\n\nModeration, user management,\nplatform operations"
        },
        {
          "id": "ctx-platform",
          "type": "node",
          "parent": "ctx-1",
          "label": "Video Streaming Platform\n[Software System]\n\nUpload, transcode, stream videos\nto millions of users"
        },
        {
          "id": "ctx-cdn",
          "type": "node",
          "parent": "ctx-1",
          "label": "CDN\n[External System]\n\nCloudFront / Akamai\nVideo delivery to users"
        },
        {
          "id": "ctx-s3",
          "type": "node",
          "parent": "ctx-1",
          "label": "Object Storage (S3)\n[External System]\n\nAWS S3 / MinIO\nVideo files (original + transcoded)"
        },
        {
          "id": "ctx-payment",
          "type": "node",
          "parent": "ctx-1",
          "label": "Payment Gateway\n[External System]\n\nStripe / PayPal\nMonetization & payouts"
        },
        {
          "id": "ctx-moderation",
          "type": "node",
          "parent": "ctx-1",
          "label": "AI Moderation API\n[External System]\n\nAWS Rekognition / Google Vision\nContent moderation"
        },
        {
          "id": "ctx-sms",
          "type": "node",
          "parent": "ctx-1",
          "label": "SMS / Push Provider\n[External System]\n\nFirebase / Kavenegar\nNotifications"
        },
        {
          "id": "ctx-maxmind",
          "type": "node",
          "parent": "ctx-1",
          "label": "MaxMind GeoIP\n[External System]\n\nGeo-blocking by IP"
        },
        {
          "id": "ctx-live",
          "type": "node",
          "parent": "ctx-1",
          "label": "Live Streaming CDN\n[External System]\n\nMux / Wowza\nRTMP → HLS for live"
        },
        {
          "id": "ctx-r1",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-viewer",
          "target": "ctx-platform",
          "label": "Watches videos, likes, comments\n[HTTPS + WebSocket]"
        },
        {
          "id": "ctx-r2",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-creator",
          "target": "ctx-platform",
          "label": "Uploads videos, live streams\n[HTTPS + RTMP]"
        },
        {
          "id": "ctx-r3",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-admin",
          "target": "ctx-platform",
          "label": "Moderates content\n[HTTPS]"
        },
        {
          "id": "ctx-r4",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-cdn",
          "label": "Serves video chunks\n[HTTPS/HLS]"
        },
        {
          "id": "ctx-r5",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-s3",
          "label": "Stores & retrieves files\n[AWS SDK]"
        },
        {
          "id": "ctx-r6",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-payment",
          "label": "Charges & pays out\n[HTTPS/REST]"
        },
        {
          "id": "ctx-r7",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-moderation",
          "label": "Moderates content\n[HTTPS/REST]"
        },
        {
          "id": "ctx-r8",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-sms",
          "label": "Sends notifications\n[HTTPS/REST]"
        },
        {
          "id": "ctx-r9",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-maxmind",
          "label": "Resolves IP location\n[REST]"
        },
        {
          "id": "ctx-r10",
          "type": "edge",
          "parent": "ctx-1",
          "source": "ctx-platform",
          "target": "ctx-live",
          "label": "Pushes live stream\n[RTMP]"
        }
      ]
    },
    {
