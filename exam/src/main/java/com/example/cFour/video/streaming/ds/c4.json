    {
      "id": "xurHUA6VPxptKNRr2lMh",
      "name": "Component",
      "cells": [
        {
          "id": "cf-1",
          "type": "layer"
        },
        {
          "id": "cf-title",
          "type": "node",
          "parent": "cf-1",
          "label": "Video Streaming Platform — All Services Components (C4 Level 3)"
        },
        {
          "id": "g-video",
          "type": "node",
          "parent": "cf-1",
          "label": "Video Service [Container: Spring Boot]"
        },
        {
          "id": "v-ctrl",
          "type": "node",
          "parent": "cf-1",
          "label": "VideoController\n[Spring REST]\n\n+ getVideo(id)\n+ searchVideos(query)\n+ likeVideo(id)\n+ commentVideo(id, msg)"
        },
        {
          "id": "v-svc",
          "type": "node",
          "parent": "cf-1",
          "label": "VideoService\n[Spring Service]\n\n+ getMetadata()\n+ incrementView()\n+ publishEvent()"
        },
        {
          "id": "v-repo",
          "type": "node",
          "parent": "cf-1",
          "label": "VideoRepository\n[Spring Data JPA]\n\n+ findById()\n+ save()\n+ search()"
        },
        {
          "id": "v-viewcounter",
          "type": "node",
          "parent": "cf-1",
          "label": "ViewCounterService\n[Spring Component]\n\n+ recordView(userId, videoId)\n+ getUniqueViews(videoId)\nuses Redis HyperLogLog"
        },
        {
          "id": "v-comment",
          "type": "node",
          "parent": "cf-1",
          "label": "CommentService\n[Spring Service]\n\n+ addComment()\n+ getComments()\n+ deleteComment()"
        },
        {
          "id": "v-like",
          "type": "node",
          "parent": "cf-1",
          "label": "LikeService\n[Spring Component]\n\n+ like(userId, videoId)\n+ unlike(userId, videoId)\n+ getCount(videoId)"
        },
        {
          "id": "e-v1",
          "type": "edge",
          "parent": "cf-1",
          "source": "v-ctrl",
          "target": "v-svc"
        },
        {
          "id": "e-v2",
          "type": "edge",
          "parent": "cf-1",
          "source": "v-svc",
          "target": "v-repo"
        },
        {
          "id": "e-v3",
          "type": "edge",
          "parent": "cf-1",
          "source": "v-svc",
          "target": "v-viewcounter"
        },
        {
          "id": "e-v4",
          "type": "edge",
          "parent": "cf-1",
          "source": "v-ctrl",
          "target": "v-comment"
        },
        {
          "id": "e-v5",
          "type": "edge",
          "parent": "cf-1",
          "source": "v-svc",
          "target": "v-like"
        },
        {
          "id": "g-upload",
          "type": "node",
          "parent": "cf-1",
          "label": "Upload Service [Container: Spring Boot]"
        },
        {
          "id": "u-ctrl",
          "type": "node",
          "parent": "cf-1",
          "label": "UploadController\n[Spring REST]\n\n+ initiateUpload(metadata)\n+ completeUpload(uploadId)\n+ cancelUpload(uploadId)"
        },
        {
          "id": "u-svc",
          "type": "node",
          "parent": "cf-1",
          "label": "UploadService\n[Spring Service]\n\n+ validateFile()\n+ generateUploadId()\n+ publishUploadEvent()"
        },
        {
          "id": "u-presigned",
          "type": "node",
          "parent": "cf-1",
          "label": "PresignedUrlGenerator\n[Spring Component]\n\n+ generateS3Url()\n+ generateMultipartUrls()"
        },
        {
          "id": "u-multipart",
          "type": "node",
          "parent": "cf-1",
          "label": "MultipartUploadHandler\n[Spring Component]\n\n+ completeMultipart()\n+ abortMultipart()"
        },
        {
          "id": "e-u1",
          "type": "edge",
          "parent": "cf-1",
          "source": "u-ctrl",
          "target": "u-svc"
        },
        {
          "id": "e-u2",
          "type": "edge",
          "parent": "cf-1",
          "source": "u-svc",
          "target": "u-presigned"
        },
        {
          "id": "e-u3",
          "type": "edge",
          "parent": "cf-1",
          "source": "u-svc",
          "target": "u-multipart"
        },
        {
          "id": "g-trans",
          "type": "node",
          "parent": "cf-1",
          "label": "Transcoding Service [Container: Spring Boot + FFmpeg + GPU]"
        },
        {
          "id": "t-ctrl",
          "type": "node",
          "parent": "cf-1",
          "label": "TranscodingController\n[Spring REST]\n\n+ startJob(videoId)\n+ getStatus(jobId)\n+ cancelJob(jobId)"
        },
        {
          "id": "t-orch",
          "type": "node",
          "parent": "cf-1",
          "label": "TranscodingOrchestrator\n[Kafka Consumer]\n\n+ onVideoUploaded()\n+ spawnWorkerPods()\n+ processRendition()\n+ buildHlsPlaylist()\n+ updateStatus()"
        },
        {
          "id": "t-jobrepo",
          "type": "node",
          "parent": "cf-1",
          "label": "TranscodingJobRepository\n[Spring Data JPA]\n\n+ save(job)\n+ findById()\n+ findByStatus()"
        },
        {
          "id": "t-spliter",
          "type": "node",
          "parent": "cf-1",
          "label": "VideoSpliter\n[FFmpeg]\n\n+ split(input)\n+ generateChunks()"
        },
        {
          "id": "t-encoder",
          "type": "node",
          "parent": "cf-1",
          "label": "EncoderComponent\n[FFmpeg]\n\n+ encode144p()\n+ encode480p()\n+ encode1080p()\n+ encode4K()"
        },
        {
          "id": "t-hls",
          "type": "node",
          "parent": "cf-1",
          "label": "HLSPlaylistBuilder\n[FFmpeg]\n\n+ buildMaster()\n+ buildMediaPlaylist()"
        },
        {
          "id": "t-dash",
          "type": "node",
          "parent": "cf-1",
          "label": "DASHBuilder\n[FFmpeg]\n\n+ buildMpd()\n+ buildSegments()"
        },
        {
          "id": "e-t1",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-ctrl",
          "target": "t-orch"
        },
        {
          "id": "e-t2",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-orch",
          "target": "t-jobrepo"
        },
        {
          "id": "e-t3",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-orch",
          "target": "t-spliter"
        },
        {
          "id": "e-t4",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-spliter",
          "target": "t-encoder"
        },
        {
          "id": "e-t5",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-encoder",
          "target": "t-hls"
        },
        {
          "id": "e-t6",
          "type": "edge",
          "parent": "cf-1",
          "source": "t-encoder",
          "target": "t-dash"
        },
        {
          "id": "g-live",
          "type": "node",
          "parent": "cf-1",
          "label": "Live Streaming Service [Container: Wowza / Mux]"
        },
        {
          "id": "l-ctrl",
